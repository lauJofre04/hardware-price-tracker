# Copiá este archivo a .env y completá los valores. NO subas .env al repositorio.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Postgres local sin SSL: DB_SSL=false. Neon y similares: dejar sin definir (SSL con verificación).
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false   # no recomendado

# Mínimo 32 caracteres aleatorios. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Solo para `npm run crear-admin` (contraseña de al menos 12 caracteres)
ADMIN_USER=admin
ADMIN_PASSWORD=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000

# Opcionales
# CORS_ORIGIN=https://tu-dominio.com,https://otro.com
# ALERT_ON_PRICE_INCREASE=true
# ENABLE_CRON=false
