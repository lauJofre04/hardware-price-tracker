# Copiá este archivo a .env y completá los valores. NO subas .env al repositorio.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Mínimo 32 caracteres aleatorios. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Solo para crearAdmin.js (contraseña de al menos 12 caracteres)
ADMIN_USER=admin
ADMIN_PASSWORD=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
